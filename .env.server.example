# Copy to .env.server; keep it out of Git. These values belong only on the server.
NODE_ENV=production
API_HOST=0.0.0.0
PORT=4301
MONGODB_URI=
MONGODB_DATABASE=fynd_qr
GOOGLE_CLIENT_ID=
# Generate a random secret of at least 32 characters; keep it stable for visitor estimates.
ANALYTICS_SECRET=
APP_ORIGINS=https://sdkfynd.github.io
# The real, deployed API origin:
SCAN_BASE_URL=https://your-api-host.example
# Encode the GitHub Pages address in new dynamic QR codes:
SCAN_PAGE_URL=https://sdkfynd.github.io/fynd-qr/
# Optional exact hostnames, separated by commas. No implicit subdomains.
ALLOWED_DESTINATION_DOMAINS=
# Only configure CIDRs for a reverse proxy you control; never use blanket trust.
TRUSTED_PROXY_CIDRS=
# Optional geo-country header overwritten by that trusted proxy. Otherwise Unknown.
TRUSTED_COUNTRY_HEADER=
LOCAL_PREVIEW_AUTH=0
