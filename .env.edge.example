# Private server-side Supabase Edge Function secrets. Never use a VITE_ prefix.
QR_DATABASE_URL=postgresql://fynd_qr_app.PROJECT_REF:PRIVATE_PASSWORD@REGION.pooler.supabase.com:6543/postgres
# Optional Supabase database CA PEM. Certificate verification stays enabled.
QR_DATABASE_CA=
QR_ANALYTICS_SECRET=
QR_SCAN_PAGE_URL=https://sdkfynd.github.io/fynd-qr/
QR_APP_ORIGINS=https://sdkfynd.github.io
# SUPABASE_URL and SUPABASE_ANON_KEY are supplied by the Edge runtime.
