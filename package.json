{
  "name": "fynd-qr",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24 <25"
  },
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4173 --strictPort",
    "build": "tsc --noEmit && vite build && node scripts/finalize-dist.mjs",
    "check:dist": "node scripts/check-dist.mjs",
    "preview": "node preview.mjs",
    "test": "tsx --test src/qr.test.ts server/app.test.ts server/postgres.test.ts server/password-auth.test.ts server/edge-app.test.ts",
    "test:backend": "tsx --test server/app.test.ts server/postgres.test.ts server/password-auth.test.ts server/edge-app.test.ts",
    "dev:full": "tsx server/dev.ts",
    "start:api": "node --env-file-if-exists=.env.server --import tsx server/start.ts",
    "typecheck:server": "tsc -p tsconfig.server.json",
    "accounts": "node --env-file-if-exists=.env.server --import tsx server/manage-accounts.ts",
    "test:edge": "tsx --test server/edge-app.test.ts"
  },
  "dependencies": {
    "@fastify/cors": "11.3.0",
    "@fastify/rate-limit": "11.2.0",
    "@supabase/supabase-js": "^2.118.0",
    "fastify": "5.12.5",
    "google-auth-library": "11.1.0",
    "mongodb": "7.6.0",
    "pg": "^8.23.0",
    "pngjs": "^7.0.0",
    "qrcode": "1.5.4",
    "sharp": "^0.35.5",
    "tsx": "^4.20.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/pngjs": "^6.0.5",
    "@types/qrcode": "^1.5.5",
    "jsqr": "1.4.0",
    "mongodb-memory-server-core": "11.2.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
